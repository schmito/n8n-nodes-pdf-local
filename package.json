{
  "name": "n8n-nodes-pdf-local",
  "version": "0.2.0",
  "description": "Work with PDF files inside n8n on your own machine. No external API, no file leaves the host. Currently: unlock password-protected PDFs.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "pdf",
    "unlock",
    "decrypt",
    "password",
    "local",
    "offline"
  ],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/schmito/n8n-nodes-pdf-local",
  "author": {
    "name": "Olivier Schmitt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmito/n8n-nodes-pdf-local.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "fixtures": "bash test/make-fixtures.sh",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PdfPassword.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Pdf/Pdf.node.js"
    ]
  },
  "dependencies": {
    "mupdf": "^1.28.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.15"
  }
}
